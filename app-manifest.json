{
    "display_information": {
        "name": "Slacker News",
        "description": "This is a place where you can publish news stories and opinion pieces.",
        "background_color": "#000000",
        "long_description": "Bot responsible of sending new posts from Slacker News to Slack channels. The RSS feed is updated every 30 minutes.\r\n\r\nYou can add this bot to your channel with `/invite @Slacker News`\r\nand remove it with `/kick @Slacker News`"
    },
    "features": {
        "bot_user": {
            "display_name": "Slacker News",
            "always_online": false
        },
        "shortcuts": [
            {
                "name": "Delete message",
                "type": "message",
                "callback_id": "delete_message",
                "description": "Delete this message"
            }
        ],
        "slash_commands": [
            {
                "command": "/news-test",
                "description": "Send a test message",
                "usage_hint": "[guid]",
                "should_escape": false
            }
        ]
    },
    "oauth_config": {
        "scopes": {
            "bot": [
                "channels:read",
                "chat:write",
                "groups:read",
                "commands"
            ]
        },
        "pkce_enabled": false
    },
    "settings": {
        "interactivity": {
            "is_enabled": true
        },
        "org_deploy_enabled": false,
        "socket_mode_enabled": true,
        "token_rotation_enabled": false,
        "is_mcp_enabled": false
    }
}